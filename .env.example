# TradeIQ Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=TradeIQ
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://tradeiq:tradeiq@localhost:5432/tradeiq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Angel One SmartAPI (Primary Broker)
ANGELONE_API_KEY=your_angelone_api_key
ANGELONE_CLIENT_CODE=your_client_code
ANGELONE_PASSWORD=your_password
ANGELONE_TOTP_SECRET=your_totp_secret
ANGELONE_SMART_API_URL=https://apiconnect.angelone.in
ANGELONE_WEBSOCKET_URL=wss://smartapisocket.angelone.in/smart-stream

# Flattrade Pi API (Secondary Broker)
FLATTRADE_API_KEY=your_flattrade_api_key
FLATTRADE_API_SECRET=your_flattrade_api_secret
FLATTRADE_CLIENT_ID=your_client_id
FLATTRADE_REDIRECT_URL=http://localhost:8000/callback
FLATTRADE_BASE_URL=https://piconnect.flattrade.in
FLATTRADE_WEBSOCKET_URL=wss://piconnect.flattrade.in/ws

# Market Data Provider (angelone or flattrade)
MARKET_DATA_PROVIDER=angelone

# Trading Instruments (NIFTY and SENSEX only per BRD)
TRADING_INSTRUMENTS=["NIFTY", "SENSEX"]

# Strategy Configuration
ORB_ENABLED=true
ORB_OPENING_RANGE_MINUTES=15
ORB_MIN_RELATIVE_VOLUME=1.5

VWAP_PULLBACK_ENABLED=true
VWAP_PULLBACK_TOLERANCE_PCT=0.3

SR_BREAKOUT_ENABLED=true
SR_BREAKOUT_MIN_TOUCHES=2
SR_BREAKOUT_CLUSTER_DISTANCE_PCT=0.2

# Indicator Parameters
EMA_PERIODS=[9, 20, 50]
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ADX_PERIOD=14
ATR_PERIOD=14
BOLLINGER_PERIOD=20
BOLLINGER_STD=2
RELATIVE_VOLUME_PERIOD=20

# Market Regime Detection
ADX_TREND_THRESHOLD=25
ADX_STRONG_THRESHOLD=40
ATR_HIGH_VOLATILITY_MULTIPLIER=1.5
ATR_LOW_VOLATILITY_MULTIPLIER=0.5
EMA_TREND_LOOKBACK=20
HYSTERESIS_BARS=3

# ML Configuration
ML_MODEL_PATH=models/knn_classifier.joblib
ML_SCALER_PATH=models/scaler.joblib
KNN_NEIGHBORS=15
KNN_WEIGHTS=distance
ML_CONFIDENCE_THRESHOLD=0.65
ML_RETRAIN_INTERVAL_DAYS=7

# Risk Management
INITIAL_RISK_PER_TRADE_PCT=0.0035
MAX_DAILY_LOSS_PCT=0.0125
MAX_SIMULTANEOUS_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=3
TARGET_R_MULTIPLE=2.0
PARTIAL_EXIT_R_MULTIPLE=1.5
TRAILING_STOP_ACTIVATION_R=1.0
TRAILING_STOP_DISTANCE_ATR=1.0
MAX_SLIPPAGE_PCT=0.002
CASH_BUFFER_PCT=0.10

# Options Configuration
PREFERRED_STRIKES=["atm", "otm_1", "itm_1"]
MAX_SPREAD_PCT=0.05
MIN_OI_THRESHOLD=1000
MIN_VOLUME_THRESHOLD=500
LOT_SIZE_NIFTY=75
LOT_SIZE_SENSEX=10
EXPIRY_SELECTION=current_weekly
SLIPPAGE_BUFFER_PCT=0.01
CHARGES_BUFFER_PCT=0.005

# Order Management
IDEMPOTENCY_KEY_TTL_SECONDS=300
ORDER_TIMEOUT_SECONDS=30
RECONCILIATION_INTERVAL_SECONDS=60
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2
BRACKET_ORDER_ENABLED=false

# Backtesting
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2026-11-04
BACKTEST_SLIPPAGE_PCT=0.001
BACKTEST_COMMISSION_PER_LOT=20
BACKTEST_STT_PCT=0.0005
BACKTEST_EXCHANGE_TXN_PCT=0.000345
BACKTEST_GST_PCT=0.18
BACKTEST_SEBI_PCT=0.000001
BACKTEST_STAMP_DUTY_PCT=0.00003

# Monitoring
LATENCY_BUCKETS=[0.01, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]
HEALTH_CHECK_INTERVAL_SECONDS=30
METRICS_RETENTION_DAYS=30
ALERT_ON_DAILY_LOSS_PCT=0.01
ALERT_ON_CONSECUTIVE_LOSSES=2